{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "JsonExport",
  "version": "0.1.1",
  "identifier": "com.jsonexport.app",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "JsonExport",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/theGoodB0rg/json_hub/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVFN0JGQ0YwRjJFNTM5ODkKUldTSk9lWHk4UHg3WGpJUzNTMUhtN3pHc2sxOFU0VWp1bUZBR2YvUWJMTU9HWWNoRStUQ0ZGa1MK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      },
      "wix": {
        "upgradeCode": "C8A61E3B-6E8E-4B6E-8C5C-9B3A6A0E7D21"
      }
    },
    "fileAssociations": [],
    "longDescription": "Native desktop JSON → Excel/CSV converter. Handles 1 GB+ files, batch conversions, and folder-watch.",
    "shortDescription": "Convert any JSON file to Excel/CSV instantly.",
    "copyright": "Copyright 2026 JsonExport",
    "category": "DeveloperTool",
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
