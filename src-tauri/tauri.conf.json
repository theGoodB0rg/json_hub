{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "JsonExport",
  "version": "0.1.0",
  "identifier": "com.jsonexport.app",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "JsonExport",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/theGoodB0rg/json_hub/releases/latest/download/updater.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZFNjBCRUNBMzMyMkQyRTIKUldUaTBpSXp5cjVnL3FJMitZaWhhU3ZZNFo4dGlqWGIreGtvYWdtRjlIeU1PM2E1RjlCU2lsWngK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
